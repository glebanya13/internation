# =============================================================================
# Локальная разработка
# =============================================================================
NODE_ENV=development

# Основная база (локальный PostgreSQL)
DATABASE_URL=postgres://localhost:5432/dorm_duty

# База для тестов — пересоздаётся при каждом прогоне
TEST_DATABASE_URL=postgres://localhost:5432/dorm_duty_test

# Секрет сессий (в production — обязателен, ≥ 32 символов)
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-before-production-32chars

# Публичный URL админки (для ссылок и cookie; в production — ваш домен)
PUBLIC_BASE_URL=http://localhost:3000

# Порт API (локально; в Docker задаётся в compose)
PORT=3000

# =============================================================================
# Telegram (опционально)
# =============================================================================
# Без токена API и админка работают; бот и доставка уведомлений отключены.
TELEGRAM_BOT_TOKEN=

# =============================================================================
# Планировщик
# =============================================================================
SCHEDULER_INTERVAL_MINUTES=5

# =============================================================================
# PostgreSQL (docker compose)
# =============================================================================
POSTGRES_DB=dorm_duty
POSTGRES_USER=dorm
POSTGRES_PASSWORD=

# =============================================================================
# Production (docker compose на VPS)
# =============================================================================
# NODE_ENV=production
# PUBLIC_BASE_URL=https://duty.example.org
# SECURE_COOKIES=true          # или оставьте false — nginx передаст X-Forwarded-Proto
# PG_POOL_MAX=3                # на VPS 1 vCPU / 2 GiB RAM — не увеличивайте без нужды
# HTTP_PORT=80
