# Пример конфигурации Nginx с HTTPS (Let's Encrypt).
# Скопируйте в deploy/nginx.conf после получения сертификата.
# Замените duty.example.org на ваш домен.

upstream api_backend {
    server api:3000;
    keepalive 8;
}

# Редирект HTTP → HTTPS
server {
    listen 80;
    server_name duty.example.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name duty.example.org;

    ssl_certificate     /etc/letsencrypt/live/duty.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/duty.example.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    proxy_connect_timeout 30s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/html
        application/json
        application/javascript
        application/xml;

    location / {
        proxy_pass         http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
